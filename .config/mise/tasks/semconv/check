#!/bin/sh
#MISE description="Validate the semantic convention registry and generated contract"

set -eu

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../../../.." && pwd)
expected="$root/trogon-eventstore/src/observability"
generated=$(mktemp -d)
trap 'rm -rf "$generated"' EXIT HUP INT TERM

"$root/.config/mise/tasks/semconv/generate" "$generated"
diff -u "$expected/generated.rs" "$generated/generated.rs"
